ELEVENLABS_PROFESSIONAL_VOICE_CLONE_TRAINING_MODEL=
PROFESSIONAL_VOICE_CLONE_POLL_INTERVAL_SECONDS=
ELEVENLABS_TEXT_TO_SPEECH_MODEL=
ELEVENLABS_TEXT_TO_SPEECH_COST_PER_1000_CHARACTERS_USD=
ELEVENLABS_LIP_SYNC_MODEL=
ELEVENLABS_LIP_SYNC_RESOLUTION=
ELEVENLABS_LIP_SYNC_COST_PER_SECOND_USD=
ELEVENLABS_LIP_SYNC_POLL_INTERVAL_SECONDS=
LIP_SYNC_ENABLED=

# Agent inbox. Connected mailboxes are polled on a schedule; each new message is
# classified (ignore / notify / respond), drafted in the owner's voice, scored
# against the owner's recorded preferences, and sent automatically only above
# the confidence threshold — otherwise it waits for the owner in the inbox.
INBOX_POLL_ENABLED=
INBOX_POLL_INTERVAL_SECONDS=
INBOX_FETCH_MAX_MESSAGES=
INBOX_AUTO_SEND_CONFIDENCE=

# Ambient vision. The browser sends webcam / screen snapshots through
# POST /message/{assistant_id} with ambient=true; each snapshot is described
# into a hidden conversation turn and triaged as ignore / respond / notify.
# The API enforces a minimum interval per thread; the browser's own interval is
# VITE_AMBIENT_CAPTURE_INTERVAL_SECONDS in the frontend (default 30).
AMBIENT_CAPTURE_ENABLED=
AMBIENT_CAPTURE_MIN_INTERVAL_SECONDS=
AMBIENT_CAPTURE_MAX_IMAGE_BYTES=
AMBIENT_PREFERENCE_RECALL_LIMIT=

# Continuous learning & personalization (feedback, ratings, sentiment, preferences)
