# Voice cloning and speech. Every avatar gets an instant voice clone from its
# reference audio (>= 60 s, rebuilt at 120 s); the personal avatar keeps
# collecting its own speech from uploads until 30 minutes, then a professional
# clone is verified (spoken CAPTCHA) and trained. Speech and lip-sync are
# rendered with the active clone; costs are recorded per call in api_metrics.
ELEVENLABS_API_KEY=
ELEVENLABS_INSTANT_VOICE_CLONE_MINIMUM_SECONDS=
ELEVENLABS_INSTANT_VOICE_CLONE_TARGET_SECONDS=
