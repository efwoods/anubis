COMPOSE_PROJECT_NAME=

TOGETHER_API_KEY=

LLAMA_API_KEY=
LLAMA_API_BASE_URL=

MODEL=

# Primary model context window and prompt budgeting (absolute tokens).
MODEL_TOKEN_LIMIT=400000
CONTEXT_COMPLETION_RESERVE_TOKENS=65536
CONVERSATION_VERBATIM_TAIL_MESSAGES=24
CONTEXT_SUMMARIZATION_MAX_CHUNKS=32
MAP_REDUCE_CHUNK_MAX_TOKENS=120000
SYSTEM_PROMPT_MAX_TOKENS=120000
MEMORY_RETRIEVAL_MAX_ITEMS=200

DEV=
# true = webapp opens debugpy on 0.0.0.0:5678 at import (compose maps host 5678).
DEBUG=
PROD=

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="anubis"

HUGGINGFACE_TOKEN=

# Configuration
EMBEDDING_MODEL=

# PRODUCTION
# VECTORSTORE_POSTGRES_URI=
# ASYNC_POSTGRES_STORE_URI=

# LOCAL TESTING
# POSTGRES_URI=
# ASYNC_POSTGRES_STORE_URI=

# REDIS_URI=
# POSTGRES_URI=

ENABLE_TARGET_SPEAKER_ATTRIBUTION=
TARGET_SPEAKER_ATTRIBUTION_TRANSCRIPT_CHARACTER_LIMIT=
TEXT_DIALOGUE_SEGMENTATION_WINDOW_CHARACTERS=
TEXT_DIALOGUE_SEGMENTATION_MAX_CHARACTERS=
NARRATIVE_SPEECH_EXTRACTION_ENABLED=
STRUCTURED_WEB_EXTRACTION_ENABLED=

MEDIA_PROCESSING_CONCURRENCY=

STANDARDIZED_QUESTION_ANALYSIS_CONCURRENCY=
GROUND_TRUTH_CALIBRATION_TIMEOUT_SECONDS=

ENABLE_DOCUMENT_ANALYSIS=

# Tukey fence of the leave-one-out squared-Mahalanobis distribution over the
# bundled ChatGPT baseline matrix; recalibrated by data/build_baseline_features_arr.py.
BASELINE_RESPONSE_THRESHOLD=

OPENAI_SPEECH_MAX_RETRIES=
OPENAI_SPEECH_RETRY_BASE_SECONDS=

# Deep agent (think node)
DEEP_AGENT_SUMMARIZATION_MAX_TOKENS=
DEEP_AGENT_SUMMARIZATION_KEEP_LAST_N_MESSAGES=
DEEP_AGENT_RECURSION_LIMIT=

# Stripe metering & subscriptions
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRODUCT_ID=
STRIPE_PAYMENT_URL=
# Fallback-only: /manage_subscription now creates a Stripe billing-portal
# session per request; this static login URL is used only when
# STRIPE_BILLING_CONFIG_JSON is not configured.
STRIPE_MANAGE_SUBSCRIPTION_URL=
# Signing secret for POST /stripe/webhook (whsec_...).
# Prod: paste the Dashboard "Your account" endpoint signing secret once.
# Local compose: leave empty and let stripe-cli write STRIPE_WEBHOOK_SECRET_FILE.
STRIPE_WEBHOOK_SECRET=
# File path for the CLI-forwarded secret (docker-compose sets this automatically).
STRIPE_WEBHOOK_SECRET_FILE=
# JSON of meter + tier price ids emitted by scripts/provision_stripe_billing.py.
# Leave EMPTY unless you are deliberately pinning specific price ids: this value
# takes precedence over STRIPE_BILLING_CONFIG_FILE, so a stale blob here silently
# overrides every reprovision and makes an edited price look like it did nothing.
STRIPE_BILLING_CONFIG_JSON=
# File path for the provisioned billing-config JSON (docker-compose sets this
# automatically; the stripe-provision service writes it). The API re-reads this
# file when its modification time changes, so an edited price takes effect
# without restarting the API.
STRIPE_BILLING_CONFIG_FILE=

# Usage-allotment period, in days, for local gating and the subscription-status
# endpoint. Zero or empty means calendar-month periods (the default).
USAGE_PERIOD_DAYS=
# Per-user token rate limits (tokens-per-window, in the spirit of the OpenAI
# rate-limit guide). Zero or empty disables a limit.
MESSAGE_RATE_LIMIT_WINDOW_SECONDS=
MESSAGE_RATE_LIMIT_TOKENS_PER_WINDOW=
MEDIA_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=
MEDIA_UPLOAD_RATE_LIMIT_TOKENS_PER_WINDOW=
# Pre-request token-estimation constants. Analysis passes: how many identity
# analysis passes re-read one uploaded item's extracted content (0 = analysis
# dropped). Static prompt / expected output: known per-turn prompt overhead
# and reply budget for the manual message estimate (calibrate from api_metrics).
ESTIMATED_ANALYSIS_PASSES_PER_DOCUMENT=
MESSAGE_EXPECTED_OUTPUT_TOKENS_ESTIMATE=
SYSTEM_PROMPT_TOKEN_ESTIMATE_CACHE_TTL_SECONDS=
# Comma-separated metering identifiers that skip usage enforcement (402/429)
# and metering writes exactly like ADMIN_USER_ID, for testing flows that
# ADMIN_USER_ID cannot cover. An anonymous requester has no account, so the
# entry is the hashed IP stamped into identities[0].user_id — sha256 of the
# x-forwarded-for value. LEAVE EMPTY IN PRODUCTION: every identifier listed
# here is an unmetered, unenforced requester.
ADMIN_METERING_BYPASS_IDENTIFIERS=
# Same identifier format, weaker bypass: these requesters skip ENFORCEMENT ONLY
# and are still metered to Stripe and to api_metrics, so an anonymous tester can
# be driven past the free-tier allotment while the customer portal,
# /verify_subscription_status and the SSE usage frames keep advancing together.
# Honored ONLY when DEV=TRUE, so a leftover entry is inert in production.
DEV_METERED_ENFORCEMENT_BYPASS_IDENTIFIERS=
# Comma-separated AVATAR (assistant) identifiers that anonymous visitors may
# message with no enforcement at all — neither the 402 exhausted-allotment
# refusal nor the 429 token rate limit — while every turn is still metered to
# Stripe and to api_metrics. Keyed on the avatar rather than the requester
# because a public demonstration avatar answers visitors whose hashed IP cannot
# be listed in advance, and applied only to anonymous requesters so an
# authenticated account cannot obtain unlimited free messaging by aiming at a
# listed avatar. Unlike the two lists above this one IS honored in production,
# which is its purpose: list an avatar only when unlimited anonymous traffic to
# that avatar is genuinely intended, and expect to pay for the usage it meters.
UNRESTRICTED_ANONYMOUS_MESSAGING_AVATAR_IDENTIFIERS=
# Accounts that are UNCAPPED WITHIN THEIR TIER: the 402 exhausted-allotment
# refusal and the 429 token rate limit stop applying, so a listed account may run
# past the allotment of whatever tier the account holds. The TIER IS UNCHANGED and
# no capability is granted — the 403 tier-capability gate still applies in full,
# so a listed account on the free tier is refused uploads exactly like any other
# free-tier account, and reaches uploads by changing tier (which these accounts
# are free to do). Every token is STILL metered to Stripe and to api_metrics,
# so the cost of demonstrating and testing the product stays visible wherever
# real usage appears. An entry is preferably the EMAIL ADDRESS, the only durable
# handle — Auth0 mints a new user id whenever an account is deleted and signs up
# again, while the email address does not change; the prefixed "auth0|<subject>"
# user id and the bare subject are accepted too, because both spellings are
# already live (resolve_metering_user_id returns the prefixed form, ADMIN_USER_ID
# and the avatar-ownership checks use the bare form). An email entry matches only
# when the address is verified, and anonymous requesters never match. Unlike
# DEV_METERED_ENFORCEMENT_BYPASS_IDENTIFIERS this list IS honored in production,
# which is the purpose: the demonstration account has to work against the
# deployed API, which runs DEV=FALSE.
UNRESTRICTED_METERED_ACCOUNT_IDENTIFIERS=
ANONYMOUS_BILLING_ENABLED=
# Stripe as the usage source of truth. TRUE or empty (the default) reads period
# usage from Stripe's Billing Meter aggregation — the same number the customer
# portal shows — and keeps the local api_metrics sum as a floor and as the
# fallback when Stripe cannot be read; FALSE returns to local-only accounting.
# The cache time-to-live bounds how often a message turn pays for a Stripe
# usage call (zero reads Stripe on every metered request).
STRIPE_USAGE_SOURCE_OF_TRUTH_ENABLED=
STRIPE_USAGE_CACHE_TTL_SECONDS=

# Data analysis (Model Context Protocol filesystem -> deep agent)
DATA_ANALYSIS_ENABLED=
DATA_ANALYSIS_MCP_URL=
DATA_ANALYSIS_MCP_DISCOVERY_URL=
DATA_ANALYSIS_DISCOVERY_TIMEOUT_SECONDS=
DATA_ANALYSIS_MCP_TRANSPORT=
DATA_ANALYSIS_MCP_SERVER_NAME=
DATA_ANALYSIS_EXECUTION_BACKEND=
DATA_ANALYSIS_WORKSPACE_ROOT=
DATA_ANALYSIS_STORE_MAX_BYTES=
DATA_ANALYSIS_STORE_MAX_AGE_DAYS=
DATA_ANALYSIS_REGISTRATION_STALE_SECONDS=
DATA_ANALYSIS_RELAY_REQUEST_TIMEOUT_SECONDS=
DATA_ANALYSIS_INLINE_ARTIFACT_MAX_BYTES=
DATA_ANALYSIS_DEVICE_FANOUT_TIMEOUT_SECONDS=
DATA_ANALYSIS_MAX_DEVICES_PER_USER=

BROWSER_TOOLS_ENABLED=
# BROWSER_CHROMIUM_EXECUTABLE_PATH is listed but deliberately left COMMENTED OUT,
# unlike every other variable in this file. The Docker base image already sets it
# to /usr/bin/chromium; because docker compose env_file entries override image
# ENV, copying an empty assignment into a live .env / .env.dev replaces that path
# with an empty string, which sends Playwright to its managed Chromium download —
# never installed in the wolfi image — and fails every browser launch. Uncomment
# only to point at a Chromium outside the container.
# BROWSER_CHROMIUM_EXECUTABLE_PATH=
BROWSER_CONVERSATION_IDLE_TIMEOUT_SECONDS=
BROWSER_MAX_CONCURRENT_CONVERSATIONS=

# Customer portal usage push. After each metered turn the API posts the caller's
# new cumulative usage to this endpoint so the portal's meters move immediately
# instead of waiting for Stripe's meter aggregation. Fire-and-forget and
# fail-open — an unreachable portal never delays or breaks a message, and the
# portal self-corrects from its own Stripe read. Empty disables the push.
# The secret must match the portal's USAGE_EVENT_SHARED_SECRET exactly.
PORTAL_USAGE_EVENT_URL=
PORTAL_USAGE_EVENT_SECRET=

# Customer portal single sign-on. A user signed in to the web application opens
# its billing page, which embeds the portal, and is signed in to the portal
# without a second login. This secret signs the short-lived exchange code the
# web application hands to the portal frame and authenticates the portal's call
# back here to spend it. Must match the portal's NN_EXCHANGE_SHARED_SECRET
# exactly. Empty disables single sign-on and the portal shows its sign-in card.
BILLING_PORTAL_EXCHANGE_SECRET=

# Connected accounts (mailbox and social) for the personal avatar.
# CONNECTED_ACCOUNT_ENCRYPTION_KEY encrypts the credentials the owner connects
# (currently mailbox app passwords) — the only platform secret that must be
# recoverable rather than merely comparable, because the avatar presents it to a
# mail server on a later turn. Generate one with:
#   python -c "from src.anubis.utils.secret_store import generate_encryption_key; print(generate_encryption_key())"
# Rotating it invalidates every stored credential, which surfaces to the owner as
# "reconnect your mailbox" rather than as silent corruption. Leaving it unset
# disables connecting accounts; it does not break anything else.
# NOTE on Gmail: since 2025-03-14 Google no longer accepts a regular account
# password over IMAP. Owners must supply a 16-character app password, which
# requires 2-Step Verification: https://myaccount.google.com/apppasswords
CONNECTED_ACCOUNT_ENCRYPTION_KEY=
MAX_CONNECTED_ACCOUNTS_PER_USER=
MAILBOX_FETCH_MAX_MESSAGES=
MAILBOX_REQUEST_TIMEOUT_SECONDS=
# MAILBOX_SEND_ENABLED lets the personal avatar transmit email through a
# connected mailbox when the owner explicitly asks in conversation; set to
# false for a draft-only avatar. Custom connectors are the owner's own Model
# Context Protocol servers; the probe timeout bounds how long a server may
# take to list its tools before it is skipped for the turn.
MAILBOX_SEND_ENABLED=
MAX_CUSTOM_MCP_CONNECTORS_PER_USER=
MCP_CONNECTOR_PROBE_TIMEOUT_SECONDS=
